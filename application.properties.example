# Copia estas líneas a src/main/resources/application.properties o usa variables de entorno.

# OpenAI
proptech.llm.provider=openai
proptech.llm.api-key=TU_API_KEY_AQUI
proptech.llm.base-url=https://api.openai.com/v1
proptech.llm.model=gpt-4o-mini

